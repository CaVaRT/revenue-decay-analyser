# Copy this file to `.env` and fill in real values.
# Do not commit `.env` with real credentials.

# GA4
GA4_PROPERTY_ID=YOUR_GA4_PROPERTY_ID
GA4_SERVICE_ACCOUNT_FILE=secrets/credentials/ga4_service_account.json
GA4_OAUTH_CLIENT_SECRETS_FILE=secrets/ga4_oauth/credentials.json
GA4_OAUTH_TOKEN_FILE=secrets/ga4_oauth/token.pickle

# GSC
GSC_SITE_URL=https://www.example.com/
GSC_SERVICE_ACCOUNT_FILE=secrets/credentials/gsc_service_account.json
